{
  "License": {
    "LicenseFile": "<path-to-firely-auth-license.json>"
  },
  "Kestrel": {
    "Endpoints": {
      "HttpsFromPem": {
        "Url": "https://0.0.0.0:5001",
        "SslProtocols": [
          "Tls12",
          "Tls13"
        ],
        "Certificate": {
          "Path": "<path-to-localhost.pem>",
          "KeyPath": "<path-to-localhost-key.pem>"
        }
      }
    }
  },
  "UserStore": {
    "Type": "Sqlite",
    "PasswordHashIterations": 600000,
    "LogSqlQueryParameterValues": false,
    "Sqlite": {
      "ConnectionString": "Data Source=<path-to-userstore.db>"
    }
  },
  "KeyManagement": {
    "RSA": {
      "JWK": "<RS256 private signing key as JWK - generate your own, never commit>",
      "SupportedAlgorithms": [
        "RS256"
      ]
    }
  },
  "FhirServer": {
    "Name": "Firely Learning",
    "FHIR_BASE_URL": "http://host.docker.internal:8081"
  },
  "Email": {
    "Type": "Smtp",
    "FromEmailAddress": "<sender@example.test>",
    "Smtp": {
      "Server": "mailpit",
      "Port": 1025,
      "RequiresAuthentication": false,
      "UseSsl": false,
      "SocketOptions": "None"
    }
  },
  "ClientRegistration": {
    "AllowedClients": [
      {
        "ClientId": "firely-learning-viewer",
        "ClientName": "Firely Learning Viewer",
        "ClientType": "StandaloneApp",
        "Enabled": true,
        "RequireConsent": true,
        "RedirectUris": [
          "https://localhost:8082/auth/callback"
        ],
        "AllowedGrantTypes": [
          "authorization_code"
        ],
        "AllowedSmartActions": [
          "r",
          "s"
        ],
        "AllowedSmartSubjects": [
          "user"
        ],
        "AllowedResourceTypes": [
          "Patient",
          "Observation",
          "Appointment",
          "DocumentReference"
        ],
        "RequirePkce": true,
        "RequireClientSecret": false,
        "AllowOfflineAccess": false,
        "AllowOnlineAccess": false,
        "AllowFirelySpecialScopes": false,
        "AllowManagementApiAccess": false,
        "EnableLocalLogin": true,
        "EnableExternalLogin": false,
        "AccessTokenType": "Jwt",
        "AccessTokenLifetime": "00:15:00"
      }
    ]
  }
}
