# Firely Server -> SQL Server (RDS) settings. Copy to firely.env (git-ignored) and fill in.
VONK_Repository=SQL
VONK_SqlDbOptions__ConnectionString=Server=<RDS_ENDPOINT>,1433;Database=<DB_NAME>;User Id=<DB_USER>;Password=<DB_PASSWORD>;Encrypt=True;TrustServerCertificate=False
VONK_SqlDbOptions__AutoUpdateDatabase=true
VONK_Administration__Repository=SQLite

# SMART on FHIR authorization (reviewer portal)
VONK_SmartAuthorizationOptions__Enabled=true
VONK_SmartAuthorizationOptions__Authority=https://localhost:5001
VONK_SmartAuthorizationOptions__Audience=<AUDIENCE>

# FHIR endpoints: converters write to the source server; the portal reads the secured one
FHIR_SOURCE_URL=http://localhost:8080
FHIR_SECURED_URL=http://localhost:8081

# Analytics pipeline
S3_BUCKET=<S3_BUCKET>
